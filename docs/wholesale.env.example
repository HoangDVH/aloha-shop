# Copy only reviewed settings into the deployment environment. No credentials are included.
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_REDIRECT_URI=https://YOUR_SHOP_DOMAIN/api/shop/auth/zalo/callback
SHOP_PUBLIC_URL=https://YOUR_SHOP_DOMAIN
SHOP_SI_TINH_MIN_ORDER=2000000
# Retailer alohanguyen (verified via GET /customers/group):
#   13004 = KHÁCH SỈ - HCM (210)
#   12731 = KHÁCH SỈ - TỈNH (57)
KV_GROUP_ID_SI_HCM=13004
KV_GROUP_ID_SI_TINH=12731
# Enable only after retailer, group IDs and customer-create contract have been verified.
SHOP_SI_KV_PROVISION_ENABLED=0
SHOP_SI_ORDER_SYNC_ENABLED=0
# Fill-only: copy ops CMS videos → shop when shop empty. Set 0 to disable.
SHOP_VIDEO_RECONCILE_ENABLED=1
# Existing mail integration is optional; use an approved sender domain.
SHOP_MAIL_ENABLED=0
RESEND_API_KEY=
SHOP_MAIL_FROM=
