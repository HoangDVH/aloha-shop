{
  "name": "aloha-shop-standalone",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev:api": "cross-env SHOP_SERVER_PORT=3001 SHOP_STANDALONE_DB=aloha_shop_db tsx backend/shop_standalone_server.ts",
    "dev:frontend": "cross-env NEXT_PUBLIC_API_BASE=http://127.0.0.1:3001 NEXT_PUBLIC_SHOP_SHOW_TRANSFER=1 npm run dev --prefix frontend",
    "dev": "concurrently -k -n api,shop -c green,cyan \"npm run dev:api\" \"npm run dev:frontend\"",
    "seed:shop-admin": "node scripts/seed-shop-admin.cjs",
    "tunnel:mongo": "node scripts/mongo-tunnel-ssh2.cjs",
    "sync:shop-product-type": "node scripts/sync-shop-product-type-from-ops.cjs",
    "install:all": "npm install && npm install --prefix frontend"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.2",
    "mongodb": "^7.5.0",
    "redis": "^4.7.1",
    "sharp": "^0.35.3",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.0",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2"
  }
}
