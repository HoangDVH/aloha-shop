{
  "manifest_version": 3,
  "name": "Aloha Auto Share - Đăng bài Facebook",
  "version": "2.3.0",
  "description": "Tự động nạp toàn bộ ảnh và bài viết từ Aloha Shop vào Facebook",
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://alohathegioichaucay.com/*",
        "http://localhost:*/*",
        "https://localhost:*/*"
      ],
      "js": ["content_aloha.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.facebook.com/*"
      ],
      "js": ["content_facebook_main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.facebook.com/*"
      ],
      "js": ["content_facebook.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content_facebook_main.js"],
      "matches": ["*://*.facebook.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Aloha Auto Share"
  }
}
