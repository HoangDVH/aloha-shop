PORT=3001
SHOP_SERVER_PORT=3001
SHOP_STANDALONE_DB=aloha_shop_db
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_URI_OPS=mongodb://127.0.0.1:27017
OPS_DB_NAME=aloha_shop_db

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# Cloudflare R2 / S3
CF_TOKEN_VALUE=
CF_ACCESSKEY=
CF_SECRET_ACCESSKEY=
CF_S3CLIENT_ENDPOINT=

# Auth Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/shop/auth/google/callback

# Public URL
SHOP_PUBLIC_URL=https://alohathegioichaucay.com
NEXT_PUBLIC_SHOP_ORIGIN=https://alohathegioichaucay.com
NEXT_PUBLIC_API_BASE=http://127.0.0.1:3001
NEXT_PUBLIC_SHOP_SHOW_TRANSFER=1

# Bank / SePay
SHOP_BANK_BIN=
SHOP_BANK_ACCOUNT=
SHOP_BANK_ACCOUNT_NAME=
SHOP_BANK_NAME=
SHOP_TRANSFER_TTL_MIN=10
SEPAY_ENABLED=0
SHOP_ALLOW_TRANSFER=1
# Id TK ngân hàng trên KiotViet (GET /bankaccounts) — gắn vào HĐ chờ CK để KV tự khớp
SHOP_KV_ACCOUNT_ID=
SHOP_KIOTQR_AWAITING=1

# Mail (0 = tắt gửi mail, 1 = bật)
SHOP_MAIL_ENABLED=0
SHOP_MAIL_PROVIDER=resend
RESEND_API_KEY=
SHOP_MAIL_FROM=

# Telegram
SHOP_TELEGRAM_BOT_TOKEN=
SHOP_TELEGRAM_CHAT_ID=

# Shipping GHN
GHN_TOKEN=
GHN_SHOP_ID=
GHN_FROM_DISTRICT_ID=

# Shipping GHTK
GHTK_API_TOKEN=
GHTK_PARTNER_CODE=
GHTK_PICK_PROVINCE=
GHTK_PICK_DISTRICT=
GHTK_PICK_WARD=

SHOP_FREE_SHIP_MAX_UNIT_VND=10000
# Voucher hỗ trợ phí ship theo vùng (1 = bật; mặc định tắt)
SHOP_SHIP_VOUCHER_ENABLED=0

# Email được mua SP giá 0đ (test) — cách nhau bởi dấu phẩy
SHOP_TEST_BUYER_EMAILS=dauvuhoang01@gmail.com

# KiotViet (ưu tiên env; không có thì đọc Mongo config id=kiotviet)
KV_CLIENT_ID=
KV_CLIENT_SECRET=
KV_RETAILER=alohanguyen
KV_AUTH_URL=https://id.kiotviet.vn/connect/token
KV_API_URL=https://public.kiotapi.com
# KV_USE_LOCAL_PROXY=1
# DB chứa config KV nếu shop DB chưa có (cùng Mongo cluster)
KV_CONFIG_DB=aloha_thumua
KIOTVIET_WEBHOOK_SECRET=
SHOP_KV_SOLD_BY_ID=
SHOP_KV_SOLD_BY_NAME=
SHOP_KV_SALE_CHANNEL_ID=
SHOP_KV_SALE_CHANNEL_NAME=

# Shop tự poll tồn/giá từ KV → chỉ $set field đã có trên aloha_products (mặc định bật)
SHOP_KV_STOCK_POLL=1
SHOP_KV_STOCK_POLL_MS=120000

# Tuyển dụng (/tuyen-dung, docs/KE_HOACH_TUYEN_DUNG.md)
# Số ngày lưu hồ sơ do Aloha chốt — để trống thì form KHÔNG nhận hồ sơ (chỉ hiện tin + liên hệ).
RECRUITMENT_RETENTION_DAYS=
# Đổi khi sửa nội dung /tuyen-dung/quyen-rieng-tu (ứng viên phải đồng ý lại bản mới).
RECRUITMENT_PRIVACY_VERSION=2026-10-05
# Nơi làm Aloha đã xác nhận cho form liên hệ chung: [{"city":"TP.HCM","address":"..."}]
RECRUITMENT_LOCATIONS=
# Nhận CV PDF/DOC/DOCX ≤5MB (server kiểm nội dung, chặn file Word có macro; chưa quét mã độc).
# Cần nginx client_max_body_size ≥ 10m cho route /api/shop/recruitment/applications.
RECRUITMENT_CV_ENABLED=0
# Thư mục CV riêng tư, KHÔNG được nằm trong uploads/ (mặc định ./private/recruitment-cv).
RECRUITMENT_CV_DIR=
# 1 = Quản lý còn phải có quyền recruitment.* trong users.permissions (app thu mua cấp).
RECRUITMENT_STRICT_PERMISSIONS=0
# Email xác nhận dùng SHOP_MAIL_ENABLED + RESEND_API_KEY; người gửi riêng (tùy chọn):
RECRUITMENT_MAIL_FROM=
# 0 = tắt worker gửi email xác nhận + xóa hồ sơ hết hạn.
RECRUITMENT_WORKER_ENABLED=1

NODE_ENV=development
