PORT=3001
SHOP_SERVER_PORT=3001
SHOP_STANDALONE_DB=aloha_shop_db
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_URI_OPS=mongodb://127.0.0.1:27017
OPS_DB_NAME=aloha_shop_db

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# Cloudflare R2 / S3
CF_TOKEN_VALUE=
CF_ACCESSKEY=
CF_SECRET_ACCESSKEY=
CF_S3CLIENT_ENDPOINT=

# Auth Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/shop/auth/google/callback

# Public URL
SHOP_PUBLIC_URL=https://shop.alohathegioichaucay.com
NEXT_PUBLIC_SHOP_ORIGIN=https://shop.alohathegioichaucay.com
NEXT_PUBLIC_API_BASE=http://127.0.0.1:3001
NEXT_PUBLIC_SHOP_SHOW_TRANSFER=1

# Bank / SePay
SHOP_BANK_BIN=
SHOP_BANK_ACCOUNT=
SHOP_BANK_ACCOUNT_NAME=
SHOP_BANK_NAME=
SHOP_TRANSFER_TTL_MIN=10
SEPAY_ENABLED=0
SHOP_ALLOW_TRANSFER=1

# Mail (0 = tắt gửi mail, 1 = bật)
SHOP_MAIL_ENABLED=0
SHOP_MAIL_PROVIDER=resend
RESEND_API_KEY=
SHOP_MAIL_FROM=

# Telegram
SHOP_TELEGRAM_BOT_TOKEN=
SHOP_TELEGRAM_CHAT_ID=

# Shipping GHN
GHN_TOKEN=
GHN_SHOP_ID=
GHN_FROM_DISTRICT_ID=

# Shipping GHTK
GHTK_API_TOKEN=
GHTK_PARTNER_CODE=
GHTK_PICK_PROVINCE=
GHTK_PICK_DISTRICT=
GHTK_PICK_WARD=

SHOP_FREE_SHIP_MAX_UNIT_VND=10000

# KiotViet
KV_AUTH_URL=https://id.kiotviet.vn/connect/token
KV_API_URL=https://public.kiotapi.com
KIOTVIET_WEBHOOK_SECRET=
SHOP_KV_SOLD_BY_ID=
SHOP_KV_SOLD_BY_NAME=
SHOP_KV_SALE_CHANNEL_ID=
SHOP_KV_SALE_CHANNEL_NAME=

NODE_ENV=development
